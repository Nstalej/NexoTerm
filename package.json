{
  "name": "nexoterm",
  "version": "0.1.0",
  "description": "Terminal persistente con conexiones PuTTY, asistente configurable y bitácoras verificables",
  "author": "NexoTerm contributors",
  "license": "MIT",
  "main": "src/main.cjs",
  "scripts": {
    "vendor": "node scripts/prepare-vendor.cjs",
    "build": "node scripts/build.cjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "node tests/e2e.cjs",
    "dist": "npm run build && electron-builder --win portable nsis --x64 --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.58.0"
  },
  "overrides": {"minimatch": "^11.0.1"},
  "build": {
    "appId": "io.nexoterm.desktop",
    "productName": "NexoTerm",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "files": [
      "src/**",
      "ui/**",
      "vendor/**",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "NexoTerm-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "NexoTerm-${version}-setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
